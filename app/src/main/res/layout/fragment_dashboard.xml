<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="24dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btnMonthSelector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="February"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="@color/text_dark"/>

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@android:drawable/arrow_down_float"
            android:rotation="-90"
            app:tint="@color/text_dark"
            android:layout_marginStart="8dp"/>

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

        <ImageView
            android:id="@+id/imgProfile"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_profile_placeholder"
            app:tint="@color/accent_red" />
    </LinearLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#D0D0D0"
        app:layout_constraintTop_toBottomOf="@id/topBar"/>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="16dp"
        android:clipToPadding="false"
        android:paddingBottom="100dp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- No tasks message -->
            <TextView
                android:id="@+id/tvNoTasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No tasks for this month"
                android:textSize="16sp"
                android:textColor="#999999"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone" />

            <!-- RecyclerView will be added programmatically here -->

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>